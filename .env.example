# Copy to .env.local (gitignored) and fill in. NEVER commit real secrets.
# All variables are read server-side only.

# --- Anthropic (leave empty to run the labelled local demo mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_STRATEGIC=claude-opus-5-5
# low | medium | high
ANTHROPIC_STRATEGIC_EFFORT=low
ANTHROPIC_MAX_OUTPUT_TOKENS=700
ANTHROPIC_MAX_OUTPUT_TOKENS_STRATEGIC=4000
# USD estimates. The global limit is a kill switch.
ANTHROPIC_MATCH_BUDGET_USD=0.75
ANTHROPIC_GLOBAL_BUDGET_USD=20
ANTHROPIC_ESCALATION_THRESHOLD=3
ANTHROPIC_REQUEST_TIMEOUT_MS=45000
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_GLOBAL_CONCURRENCY=6
ANTHROPIC_MATCH_CONCURRENCY=5
ANTHROPIC_REQUESTS_PER_MINUTE=40
# Optional pricing override (USD per million tokens)
ANTHROPIC_PRICING_JSON=
# auto | demo
AGENT_MODE=auto

# --- Tournaments ---
TOURNAMENT_CONCURRENCY=2
TOURNAMENT_MAX_LIVE_MATCHES=10

# --- Human players ---
HUMAN_TURN_TIMEOUT_MS=180000

# --- Persistence (optional; defaults to JSON files under .data/) ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AFC_DATA_DIR=
